SELECT * from Jogadores; -- seleciona todos os dados da tabela jogadores

-- para localizar dados especificos dentro de uma tabela por exemplo telefone, voce pode usar a seguinte consulta:

SELECT * from TelefonesJogadores;

-- para localizar apenas algumas colunas.
select nome_completo, apelido, turma
from Jogadores -- seleciona apenas as colunas nome_completo, apelido e turma da tabela Jogadores

-- para ver somente os 3 primeiros registros da tabela
SELECT top(50) * from Jogadores -- seleciona os 3 primeiros registros da tabela Jogadores