-- relacinando tabelas com join: permite conbinar registros de 2 ou mais tabelas com base em uma condição de correspondencia

-- inner join: retorna apenas os registros que tem correspondencia em ambas as tabelas

SELECT 
a.Nome as NomeDoALuno,
c.NomeCurso as NomeDoCurso,
m.NotaFinal,
m.StatusMatricula
from Matriculas as m 
inner join alunos as a
on m.IdAluno = a.IdAluno -- relaciona a tabela Matriculas com a tabela alunos

inner join cursos as C 
on m.IdCurso = c.IdCurso -- relaciona a tabela matriculas com a tabela cursos
order by a.nome; -- ordena o resultado pelo nome do aluno

-- join com 4 tabelas: retorna apenas os registros que tem correspondecia em todas as tabelas
SELECT
a.Nome as aluno,
a.Turma,
c.NomeCurso as Curso,
p.nome as professor,
m.NotaFinal,
m.StatusMatricula
from matriculas as m 
inner join Alunos as a 
on m.IdAluno = a.IdAluno -- relaciona a tabela alunos com a tabela matriculas

INNER JOIN Cursos as c -- relaciona a tabela cursos com a tabela matriculas
on m.IdCurso = c.IdCurso

inner join Professores as p
on c.IdProfessor = p.IdProfessor -- relaciona a tabela professores com a tabela cursos
order by p.Nome , c.NomeCurso, a.Nome;  -- ordena o resultado pelo nome do aluno


SELECT
a.Nome as NomeDoALuno,
c.NomeCurso as NomeDoCurso,
m.NotaFinal,
m.StatusMatricula
from Alunos as a
left join Matriculas as m
on a.IdAluno = m.IdAluno -- relaciona a tabela alunos com a tabela matriculas
left join Cursos as c
on m.IdCurso = c.IdCurso -- relaciona a tabela cursos com a tabela matriculas
where m.IdMatricula is null -- filtra os alunos que não possuem matricula

-- se a consulta não retornar linhas, significa que todos os alunos possuem matricula em apenas um curso

-- join com filtro e media por curso: retorna a media das notas finais por curso, considerando apenas os alunos qu possuem maticula

SELECT
c.NomeCurso as Curso,
COUNT(m.IdMatricula) as TotalDeMAtriculas,
AVG(m.NotaFinal) as MediaDoCurso
from Cursos as c
left join matriculas as m
on c.IdCurso = M.IdCurso
where m.NotaFinal is NOT NULL
GROUP BY c.NomeCurso
order by c.NomeCurso;

