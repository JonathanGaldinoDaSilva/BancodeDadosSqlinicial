-- filtros com where
-- where: filtrará as linhas. leia a consulta como uma frase: selecione os nomes e turmas dos alunos onde a turma seja igual a '2info-a'

-- igual A
SELECT Nome, Turma
from Alunos
WHERE Turma = '2info-a';

-- diferente de
SELECT Nome, Turma
from Alunos
WHERE Turma <> '2info-a';

-- and: as 2 condições devem ser verdadeiras para que o regiistro seja retornado na consulta
select Nome, Turma, DataNascimento
from Alunos
WHERE Turma = '2info-a' and DataNascimento > '2008-01-01';

-- or: pelo menos uma condição deve ser verdadeira
select Nome, Turma
from Alunos
where Turma = '2info-a' or DataNascimento > '2008-01-01';


-- in: versão mais curta para vários valores
select Nome, Turma
from Alunos
where Turma in ('2info-a', '2info-b');

-- like: % significa 'qualquer quantidade de caracteres' e _ significa "qualquer caracter"
select Nome, email
from Alunos
where Nome like '%es';

